pipeline{
    agent any

    options {
        skipDefaultCheckout(true)
        }  
    stages {       
        stage('Get Code')
        {
            steps {
                //solicitud de informacion del profesor//
                sh '''
                 whoami
                hostname
                echo "WORKSPACE=$WORKSPACE"
                '''
                //Descargar códico desde mi repositorio//
                git branch: 'master',
        	    url: 'https://github.com/ramirodhen/helloworld.git'
                //Verificación de descarga de código//
                sh 'ls -la'
                //Mostrar mi espacio de trabajo//
                sh 'echo $WORKSPACE'
                stash name:'codigo', includes:'**'
                }
        }
        stage('Static') {
        agent any
        steps {
            unstash 'codigo'
            sh '''
            flake8 --format=pylint --exit-zero app > flake8.out
            '''
            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            script {
                recordIssues(
                    tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                    qualityGates: [
                        [threshold: 8, type: 'TOTAL', unstable: true],   
                        [threshold: 10, type: 'TOTAL', unstable: false]   
                    ]
                )
            }
            }
        }
        }
        stage('Security') {
            agent any
            steps {
                unstash 'codigo'
                sh '''
                bandit -r . -f custom --msg-template '{relpath}:{line}: [{test_id}] {msg}' > bandit.out || true
                '''
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    script {
                        def issues = scanForIssues(tool: pyLint(pattern: 'bandit.out'))
                        publishIssues issues: [issues], qualityGates: [
                        [threshold: 2, type: 'TOTAL', unstable: true],
                        [threshold: 4, type: 'TOTAL', unstable: false]
                        ]
                    }
                }
            }
        }          
        stage('Tests'){
            parallel {
                stage('Unit')
                {
                    agent {label 'agent1'}
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        unstash 'codigo'                      
                        sh '''
                        set -e
                        export PYTHONPATH=.
                        python3 -m pytest test/unit \
                        --junitxml=resultado-unit.xml \
                        --cov=app \
                        --cov-branch \
                        --cov-config=.coveragerc \
                        --cov-report=xml:coverage-unit.xml
                        '''
                        junit 'resultado-unit.xml'
                      
                        stash name: 'coverage-unit-report', includes:'coverage-unit.xml'
                        }
                    }
                }               
                stage('Service')
                {
                    agent {label 'agent2'}
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        unstash 'codigo'
                        sh '''
                        set -e
                        export FLASK_APP=app.api:api_application
                        flask run &
                        java -jar /opt/wiremock/wiremock-standalone-3.13.2.jar --port 9090 --root-dir "$WORKSPACE/test/wiremock" &
                        sleep 5
                        echo "fin sleep"
                        # Ejecutamos 
                        pytest --junitxml=resultado-service.xml test/rest
                        '''
                        junit 'resultado-service.xml'
                        }
                    }
                }
            }
        }
        stage('Cobertura') {
        agent any
            steps {           
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'codigo'
                    unstash 'coverage-unit-report'
                recordCoverage(
                    enabledForFailure: true,
                    tools: [[parser: 'COBERTURA', pattern: 'coverage-unit.xml']],
                    qualityGates: [
                    [metric: 'LINE',   integerThreshold: 85, criticality: 'FAILURE'],
                    [metric: 'LINE',   integerThreshold: 95, criticality: 'UNSTABLE'],
                    [metric: 'BRANCH', integerThreshold: 80, criticality: 'FAILURE'],
                    [metric: 'BRANCH', integerThreshold: 90, criticality: 'UNSTABLE']
                    ]
                )
                }
            }
        }

        stage('Performance') {
            steps {
                sh '''
                set -e
                export FLASK_APP=app.api:api_application
                flask run &
                sleep 4
                /opt/jmeter/bin/jmeter -n -t test/jmeter/suma-resta.jmx -f -l flask.jtl
                '''
                perfReport sourceDataFiles: 'flask.jtl'
            }
        }
 
        stage('Limpieza') {
        parallel {
            stage('Clean principal') {
            agent { label 'principal' }
            steps {
                sh 'whoami; hostname; echo "WORKSPACE=$WORKSPACE"'
                deleteDir()
            }
            }
            stage('Clean agent1') {
            agent { label 'agent1' }
            steps {
                sh 'whoami; hostname; echo "WORKSPACE=$WORKSPACE"'
                deleteDir()
            }
            }
            stage('Clean agent2') {
            agent { label 'agent2' }
            steps {
                sh 'whoami; hostname; echo "WORKSPACE=$WORKSPACE"'
                deleteDir()
            }
            }
        }
        }
    }
}
